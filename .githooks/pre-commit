#!/bin/sh
# Nightglass pre-commit hook: block commits that contain secrets.
# Enabled with: git config core.hooksPath .githooks
# Fails closed: if gitleaks cannot be found, the commit is refused.

GITLEAKS="$(command -v gitleaks 2>/dev/null)"
if [ -z "$GITLEAKS" ] && [ -n "$LOCALAPPDATA" ]; then
    # winget installs here; shells opened before the install miss the PATH update
    for candidate in "$LOCALAPPDATA"/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*/gitleaks.exe; do
        [ -x "$candidate" ] && GITLEAKS="$candidate" && break
    done
fi

if [ -z "$GITLEAKS" ]; then
    echo "pre-commit: gitleaks not found. Install it (winget install Gitleaks.Gitleaks) and retry." >&2
    exit 1
fi

"$GITLEAKS" git --pre-commit --staged --redact --no-banner --verbose
status=$?
if [ $status -ne 0 ]; then
    echo "pre-commit: gitleaks found possible secrets in staged changes. Commit blocked." >&2
fi
exit $status
